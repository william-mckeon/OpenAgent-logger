# =============================================================================
# openagent-logger - environment variables (example)
# =============================================================================
#
# Copy this file to `.env` and fill in real values BEFORE running the
# service. NEVER commit `.env` - it contains secrets.
#
#     cp .env.example .env
#     # then edit .env
#
# Generate strong random secrets with:
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# Every value below has a default in the corresponding Python module if you
# leave the variable unset, except the secrets and the DB password which are
# REQUIRED for the service to start.
# =============================================================================


# -----------------------------------------------------------------------------
# Service identity / network                                       (src/api.py)
# -----------------------------------------------------------------------------

# Bind address inside the container. 0.0.0.0 = all interfaces (correct for
# containers and Render). 127.0.0.1 if you only want local-host access.
LOGGER_HOST=0.0.0.0

# Port the service listens on. Matches the Dockerfile EXPOSE and the host
# port mapping in docker-compose.yml. Continues the OpenAgent port topology:
# 8000 frontend, 8001 openagent-api, 8002 openagent-infra, 8003 openagent-logger.
LOGGER_PORT=8003

# Enable interactive Swagger docs at /docs. Off by default. Turn on for
# local dev only; never in production.
LOGGER_ENABLE_DOCS=false

# Hot-reload on source changes. Off by default. Local dev only.
LOGGER_RELOAD=false


# -----------------------------------------------------------------------------
# Logging                                                          (src/api.py)
# -----------------------------------------------------------------------------

# Standard Python log levels: DEBUG, INFO, WARNING, ERROR, CRITICAL.
LOGGER_LOG_LEVEL=INFO


# -----------------------------------------------------------------------------
# Security - two INDEPENDENT secrets                          (src/security.py)
# -----------------------------------------------------------------------------
#
# LOGGER_API_KEY is the X-API-Key header value used for transport
# authentication. Every inbound request must carry this exact value or
# is rejected with HTTP 401 at the door.
#
# LOGGER_HMAC_SECRET is the HMAC-SHA256 signing key. Each event payload
# is signed with it; the signature is verified on receipt AND stored on
# the row so auditors and any reader can re-verify integrity without
# trusting the original transport.
#
# These are INDEPENDENT: compromise of one does NOT enable forgery on
# the other. Rotate independently. Both should be at least 32 bytes of
# random data each.

LOGGER_API_KEY=replace-with-a-strong-random-key
LOGGER_HMAC_SECRET=replace-with-a-different-strong-random-secret

# Replay-window check: reject events whose client_timestamp is more than
# this many seconds away from server time. Tight = more secure but less
# tolerant of clock skew between services. 5 minutes is a reasonable
# default for normal NTP-synced infrastructure.
LOGGER_REPLAY_WINDOW_SECONDS=300


# -----------------------------------------------------------------------------
# Database                                                        (src/models.py)
# -----------------------------------------------------------------------------
#
# Two configuration styles - pick ONE:
#
#   Option A (preferred): full URL. Set LOGGER_DATABASE_URL and leave
#   the LOGGER_DB_* component vars blank. This is how Render injects
#   DATABASE_URL automatically when a service is bound to a Postgres.
#
#   Option B: component-style. Leave LOGGER_DATABASE_URL empty and set
#   each LOGGER_DB_* variable individually. Convenient for local Docker.
#
# If both are set, Option A (the full URL) wins.

# --- Option A: full URL ---
LOGGER_DATABASE_URL=

# --- Option B: components (used when LOGGER_DATABASE_URL is empty) ---
LOGGER_DB_USER=openagent_logger
LOGGER_DB_PASSWORD=replace-with-the-openagent_logger-role-password
LOGGER_DB_HOST=openagent-shared-db
LOGGER_DB_PORT=5432
LOGGER_DB_NAME=openagent_shared

# Schema inside the shared database. Should not need changing - the
# database/init.sql file creates this schema name.
LOGGER_DB_SCHEMA=openagent_logger

# Echo every SQL statement to logs. Useful for debugging; never enable
# in production - extremely chatty and may log sensitive payload data.
LOGGER_SQL_ECHO=false


# -----------------------------------------------------------------------------
# Retention windows (days)                                  (src/scheduler.py)
# -----------------------------------------------------------------------------
#
# Number of days each event type is kept before its monthly partition is
# dropped by the daily retention job. Larger = more storage, longer
# history. These match the retention_class column on each row:
#   ops_events            -> SHORT
#   conversation_captures -> MEDIUM
#   audit_events          -> LONG

LOGGER_RETENTION_OPS_DAYS=90
LOGGER_RETENTION_CONVERSATION_DAYS=180
LOGGER_RETENTION_AUDIT_DAYS=2555


# -----------------------------------------------------------------------------
# Retention schedule                                       (src/scheduler.py)
# -----------------------------------------------------------------------------

# Hour of day (UTC, 0-23) when the daily retention job runs. 3 = 03:00 UTC,
# a quiet time for most workloads. The job:
#   1. Creates next month's partitions for every managed table.
#   2. Drops partitions older than each table's retention window.
LOGGER_RETENTION_SCHEDULE_HOUR=3
